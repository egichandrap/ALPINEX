# -----------------------------------------------------------------------------
# ALPINEX Environment Configuration Template
# -----------------------------------------------------------------------------

# Application Environment (development | staging | production)
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-this-to-a-secure-random-secret-key-32bytes-min
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef # 32-character AES key

# Default Initial Administrator Credentials (Changeable as needed)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_USER=alpinex
DB_PASSWORD=alpinex_secret
DB_NAME=alpinex_db
DB_SSL_MODE=disable

# Cache & Message Broker (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Execution Engine & Worker
EXECUTION_ENGINE_DEFAULT=k6
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_AUTH_SECRET=worker-mutual-secret-token

# Security & SSRF Safeguards
SECURITY_ALLOW_PRIVATE_IPS=true # Set to false in production
QUOTA_MAX_VUS=1000
QUOTA_MAX_DURATION_MINUTES=60

# Telemetry & Retention
METRICS_RETENTION_DAYS=30
LOG_LEVEL=info
